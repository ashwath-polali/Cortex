{
  "version": 2,
  "builds": [
    {
      "src": "api/mcp_route.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/mcp(/.*)?",
      "dest": "/api/mcp_route.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
